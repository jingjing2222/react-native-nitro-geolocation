{
  "name": "@react-native-nitro-geolocation/rozenite-plugin",
  "version": "1.1.2",
  "description": "react-native-nitro-geolocation devtools plugin with rozenite",
  "type": "module",
  "main": "./dist/react-native/index.cjs",
  "module": "./dist/react-native/index.js",
  "types": "./dist/react-native/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/react-native/index.d.ts",
      "import": "./dist/react-native/index.js",
      "require": "./dist/react-native/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jingjing2222/react-native-nitro-geolocation.git",
    "directory": "packages/rozenite-devtools-plugin"
  },
  "keywords": [
    "react-native",
    "geolocation",
    "nitro",
    "devtools",
    "rozenite",
    "location",
    "mock"
  ],
  "scripts": {
    "prepack": "rozenite build",
    "build": "rozenite build",
    "dev": "rozenite dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run"
  },
  "dependencies": {
    "@rozenite/plugin-bridge": "2.2.0"
  },
  "devDependencies": {
    "@rozenite/vite-plugin": "2.2.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25.0.3",
    "@types/react": "^19.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.562.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.1",
    "react-native-web": "0.21.0",
    "rozenite": "2.2.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.3",
    "vite": "^7.3.1",
    "vitest": "4.1.5"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
